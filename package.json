{
  "name": "oxlint-plugin-pngdeer",
  "version": "0.3.0",
  "description": "Lint rule for oxlint and ESLint: flags PNGs and JPEGs your code uses that could be much smaller at about the same visual quality, with the command that shrinks them. Local WebAssembly, no upload.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "lint",
    "image-optimization",
    "image-compression",
    "png",
    "jpeg",
    "web-performance",
    "ssimulacra2",
    "webassembly",
    "pngdeer"
  ],
  "homepage": "https://github.com/lndgalante/oxlint-plugin-pngdeer#readme",
  "bugs": "https://github.com/lndgalante/oxlint-plugin-pngdeer/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lndgalante/oxlint-plugin-pngdeer.git"
  },
  "author": "Leonardo Galante",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "oxlint-plugin-pngdeer": "bin/pngdeer.js"
  },
  "files": [
    "bin",
    "src",
    "engine"
  ],
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "oxlint": ">=1.90.0 <2"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "oxlint": "1.90.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
