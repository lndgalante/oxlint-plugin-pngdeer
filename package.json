{
  "name": "oxlint-plugin-slimdeer",
  "version": "0.6.0",
  "description": "Lint rule for oxlint and ESLint: flags PNGs and JPEGs your code uses that could be at least 4 KiB and 10% smaller at about the same visual quality, measured locally with the slimdeer compressor (WebAssembly, no upload). Its command shows them before and after, shrinks them, or writes WebP and AVIF copies.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "lint",
    "image-optimization",
    "image-compression",
    "png",
    "jpeg",
    "webp",
    "avif",
    "tinypng-alternative",
    "compress-images",
    "web-performance",
    "ssimulacra2",
    "webassembly",
    "pngdeer",
    "slimdeer"
  ],
  "homepage": "https://github.com/lndgalante/oxlint-plugin-slimdeer#readme",
  "bugs": "https://github.com/lndgalante/oxlint-plugin-slimdeer/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lndgalante/oxlint-plugin-slimdeer.git"
  },
  "author": "Leonardo Galante",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "oxlint-plugin-slimdeer": "bin/slimdeer.js"
  },
  "files": [
    "bin",
    "src",
    "engine"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "oxlint --deny-warnings src bin scripts test bench .github",
    "check:package": "node scripts/check-package.js",
    "bench": "node bench/run.js",
    "check:published": "node scripts/check-package.js --published"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "oxlint": ">=1.60.0 <2"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "oxlint": "1.90.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
